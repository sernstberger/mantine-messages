{
  "name": "mantine-messages",
  "version": "0.0.0",
  "description": "Messaging components for Mantine: inbox, thread and composer for people talking to people",
  "homepage": "https://sernstberger.github.io/mantine-messages/",
  "license": "MIT",
  "author": "Steve Ernstberger",
  "keywords": [
    "chat",
    "conversation",
    "inbox",
    "mantine",
    "messages",
    "messaging",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "repository": "https://github.com/sernstberger/mantine-messages.git",
  "peerDependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "bugs": "https://github.com/sernstberger/mantine-messages/issues"
}
